# 门户 home.linzezhang.com 的拉取式部署配置。装到服务器 /etc/linze-pull-deploy/home-hub.env
# （install.sh 会安装；文件名 = timer 实例名 = app 名）。给别的项目套用：复制本文件改成 <app>.env 改这几行即可。

# ---- 必填 ----
REPO_URL=https://github.com/LinzeColin/LinzeHomeHub.git   # 公开仓，只许 https 且不带凭据（脚本会拒绝带 @ 的地址）
DOMAIN=home.linzezhang.com                                # 对外域名（Traefik Host 规则、回测都用它）
IMAGE=linze-pull/home-hub                                 # 本机镜像名，tag = 完整提交号

# ---- 可选（下面是默认值之外的取值；没写的项用脚本内默认）----
BRANCH=main
SUBDIR=.                       # Dockerfile 所在子目录（monorepo 用，如 Serenity-Alipay/xxx）；会做 sparse checkout
DOCKERFILE=Dockerfile          # 相对 SUBDIR
CONTAINER_PORT=80              # 容器内监听端口
HEALTH_PATH=/                  # 探活路径
HEALTH_CODE=200                # 期望状态码
HEALTH_BODY_REGEX='Linze Home Hub'   # 探活内容必须匹配（防止上线空白页）；留空则不查内容
VERSION_PATH=/version.txt      # status 子命令用：Dockerfile 里把提交号写到这个路径（可留空）
DOCKER_NETWORK=coolify         # Traefik（coolify-proxy）所在网络
CERT_RESOLVER=letsencrypt      # 与 coolify-proxy 的证书解析器同名；测试域名可留空（走默认证书）
MEMORY=256m
# 首次迁移专用：切换成功后把旧 Coolify 容器停掉（只停不删，留作回滚）。按标签匹配，不含令牌
RETIRE_FILTER=label=coolify.name=0d8c4960-0e59-43c8-9020-83e16e944444
