{
  "_managed_by": "status-agent-v3",
  "_managed_version": "v0.0.0.10",
  "development_only": true,
  "production_agent_dependency": 0,
  "production_token_consumption": 0,
  "daemon_required": false,
  "launchd_required": false,
  "session_receipt": {
    "capture_mode": "bounded_wrapper_plus_exact_transcript_binding",
    "raw_transcript_policy": "private_spool_or_encrypted_object_only",
    "require_exact_transcript_binding": true,
    "require_unique_transcript_binding_match": true,
    "test_only_process_output_fallback_promotable": false,
    "process_output_diagnostic": {
      "schema_version": 1,
      "enabled_for_nonzero_exit": true,
      "maximum_bytes": 1048576,
      "classification_policy": "allowlisted_signature_only_not_causal",
      "emit_raw_excerpt": false,
      "classifier_retains_raw": false,
      "sensitive_oversized_or_binary_output": "blocked",
      "ambiguity": "unclassified_non_actionable",
      "automatic_recovery": false
    },
    "promotion_requires": [
      "receipt_digest_integrity",
      "verified_default_provider_command",
      "provider_session_file",
      "exact_transcript_binding",
      "raw_transcript_digest_match",
      "independent_gate"
    ]
  },
  "providers": {
    "claude": {
      "binary": "claude",
      "capture_mode": "bounded_wrapper_plus_exact_transcript_binding",
      "cloud_sync": false,
      "critical_events": [
        "session_start",
        "process_start",
        "process_end",
        "session_end"
      ],
      "late_bound_version": true,
      "required_cli_features": [
        "--print",
        "--output-format",
        "stream-json",
        "--verbose",
        "--permission-mode",
        "plan",
        "--tools",
        "--max-budget-usd",
        "--safe-mode",
        "--no-chrome",
        "--setting-sources"
      ],
      "execution_mode": "single_prompt_read_only",
      "single_prompt_submission": true,
      "tool_access": "read_only",
      "allowed_tools": [
        "Read"
      ],
      "max_budget_usd": 1.0,
      "safe_mode": true,
      "chrome_integration": false,
      "permission_mode": "plan",
      "session_storage": {
        "config_dir_env": "CLAUDE_CONFIG_DIR",
        "config_dir_must_be_absolute": true,
        "require_persistent_transcript": true,
        "forbidden_environment_variables": [
          "CLAUDE_CODE_SKIP_PROMPT_HISTORY"
        ],
        "forbidden_cli_features": [
          "--no-session-persistence"
        ]
      },
      "settings_source_isolation": {
        "cli_argument": "--setting-sources",
        "value": "project,local",
        "allowed_sources": [
          "project",
          "local"
        ],
        "forbidden_sources": [
          "user"
        ],
        "residual_policy_sources": [
          "global_config",
          "managed_policy"
        ]
      }
    },
    "codex": {
      "binary": "codex",
      "capture_mode": "bounded_wrapper_plus_exact_transcript_binding",
      "cloud_sync": false,
      "critical_events": [
        "session_start",
        "process_start",
        "process_end",
        "session_end"
      ],
      "late_bound_version": true,
      "required_cli_features": [
        "exec",
        "--sandbox",
        "read-only",
        "--json"
      ],
      "sandbox": "read-only"
    }
  },
  "schema_version": "status.provider_contracts.v3"
}
