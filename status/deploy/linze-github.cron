# 装到 /etc/cron.d/linze-github —— GitHub Engineering Plane 采集,每 30 分钟一次(慢变量、约 50s)。
# 以 ubuntu 跑(读 .secrets/github_pat);写 data/github_public.json(公开安全)+ private/github.json(仅登录页)。
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/30 * * * * ubuntu python3 /srv/linze/apps/status/collector/collect_github.py >> /srv/linze/apps/status/github.log 2>&1
